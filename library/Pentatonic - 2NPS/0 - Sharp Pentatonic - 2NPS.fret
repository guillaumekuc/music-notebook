# id: 60fbb58d-f929-4617-a605-c5e15a97f128
# name: 0 - Sharp Pentatonic - 2NPS
# tags: 2nps, pentatonic, rootless
# all-fourths tuning

# Intervals : ♯1, 3, ♯4, 6, 7
# Intervals : ♭1, ♭2, 3, ♭5, 6 (favored spelling)
# Use this pentatonic as scaffolding to learn : Lydian ♯1, Lydian ♯1 ♯5, Lydian ♯1 ♯5 ♯2.

option start=1
option frets=12
option strings=6

show frets=2,4 strings=1
show frets=2,5 strings=2
show frets=2,5 strings=3
show frets=3,5 strings=4
show frets=3,5 strings=5
show frets=3,5 strings=6
show notes=4/6,6/4,3/1 text="R" color=red fill-color=white