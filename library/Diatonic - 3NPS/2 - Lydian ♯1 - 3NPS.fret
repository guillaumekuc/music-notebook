# id: 04c3aa01-50b1-4d12-82ba-9953aac74c69
# name: 2 - Lydian ♯1 - 3NPS
# tags: 3nps, rootless
# all-fourths tuning

# Mode = scale measured against note. Chromatic scale = 12 notes > 12 notes to measure from > 12 modes for any scale. For the diatonic scale, 5 modes do not contain a root note. This one is such a rootless mode.

option strings=7
option start=1
option frets=12
show frets=3,5,7 strings=1
show frets=3,5,7 strings=2
show frets=3,5,7 strings=3
show frets=3,5,6 strings=4
show frets=3,5,6 strings=5
show frets=3,4,6 strings=6
show frets=3,4,6 strings=7

show notes=2/7,4/5,6/3,8/1 text="R" color=red fill-color=white