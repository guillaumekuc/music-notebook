# id: 2a2ca466-9242-4334-993f-e102d3609b9c
# name: 6 - Dorian for Chord Melodies - 3NPS copy
# tags: 3nps
# all-fourths tuning

# Intervals = 1 2 ♭3 4 5 6 ♭7
# Chord 1 ♭3 5 ♭7 2 4 ; avoid 6
# Quartal stacking logic ; 1 4 ♭7 ♭3 6 2 ; avoid 5.

option start=1
option frets=12
option strings=7
show frets=3,5,6 strings=1
show frets=3,4,6 strings=2
show frets=3,4,6 strings=3
show frets=2,4,6 strings=4
show frets=2,4,6 strings=5
show frets=2,4,6 strings=6
show frets=2,4,5 strings=7
show notes=2/7,4/5,6/3 text="R" fill-color=red
show notes=8/1 text="R" color=red fill-color=white