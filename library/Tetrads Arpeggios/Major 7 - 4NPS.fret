# id: 28c42f6f-859f-45ed-bddc-90b62b69241a
# name: Major 7 - 4NPS
# tags: 4nps, tapping
# all-fourths tuning

# 2 shapes, 2 adjacent strings each repeat in octaves

option start=1
option frets=24
option strings=8


# Use one pattern, repeat in octaves. RH tapping for reach.

show frets=0,3,7,8 strings=2
show frets=1,5,6,10 strings=4
show frets=3,4,8,11 strings=6
show frets=2,6,9,13 strings=8
show notes=2/8,4/6,6/4,8/2 text="R" fill-color=red
